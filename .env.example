# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional — enables Supabase persistence (set as Railway env vars for production)
# When set, agent runs, memory entries, dream reports, and config snapshots
# are persisted to Supabase. Falls back to local JSONL/.swarm/ files when absent.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional — memory backends
MEMVID_SWARM_BRIDGE=/path/to/memvid-swarm-bridge
