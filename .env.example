# Required for live LLM calls (optional for stub/demo)
# Prefer OpenRouter for cheap/free models during launch tests:
OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_BASE_URL=https://openrouter.ai/api
# Or native Anthropic:
# ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides (OpenRouter free example):
# SWARM_MODEL_OPUS=meta-llama/llama-3.2-3b-instruct:free
# SWARM_MODEL_SONNET=meta-llama/llama-3.2-3b-instruct:free
# SWARM_MODEL_HAIKU=meta-llama/llama-3.2-3b-instruct:free

# API server — config path (Dockerfile uses /app/config automatically)
# SWARM_CONFIG_PATH=/app/config/swarm-compact.yaml

# When set, POST /api/swarm/run, /api/agent/run, /api/swarm/dream require header:
#   X-SWARM-API-KEY: <same value>
# Leave unset for local open POSTs; set in production.
# SWARM_API_KEY=

# Cap for JSON body budget_usd on POST /api/swarm/run (abuse protection)
# SWARM_MAX_RUN_BUDGET_USD=500

# Per-IP requests per minute (0 = disable rate limiting)
# SWARM_RATE_LIMIT_PER_MINUTE=120

# Optional — extra CORS origins (comma-separated)
# ALLOWED_ORIGINS=https://your-landing.example.com

# Optional — enables Supabase persistence (set as Railway env vars for production)
# When set, agent runs, memory entries, dream reports, and config snapshots
# are persisted to Supabase. Falls back to local JSONL/.swarm/ files when absent.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional — memory backends
MEMVID_SWARM_BRIDGE=/path/to/memvid-swarm-bridge

# Optional — eval harness LLM-as-judge (Haiku); requires ANTHROPIC_API_KEY
# SWARM_EVAL_LLM_JUDGE=1
# SWARM_EVAL_JUDGE_MODEL=claude-haiku-4-5-20251001

# Optional — dream cycle Haiku remediation notes
# SWARM_DREAM_USE_LLM=1
# SWARM_DREAM_LLM_MODEL=claude-haiku-4-5-20251001
